#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * wankarr command line.
 *
 *   wankarr tasks                 run every task that is due (cron: every few minutes)
 *   wankarr worker                stay running and run due tasks (containers / systemd)
 *   wankarr run <task>            run one task now (scan, metadata)
 *   wankarr scan [--library=ID]   scan libraries
 *   wankarr match <series-id>     auto-match one series
 *   wankarr status                show tasks and library totals
 *   wankarr migrate               create/upgrade the database schema
 *   wankarr prune [--yes]         delete libraries removed from the config (and their series)
 *   wankarr user list             list accounts
 *   wankarr user add NAME [--admin] [--email=ADDR]   create an account (asks for a password)
 *   wankarr user passwd NAME      set a new password (e.g. a locked-out admin)
 *   wankarr user role NAME admin|user
 *   wankarr user enable|disable|delete NAME
 */

if (PHP_SAPI !== 'cli') {
    exit(1);
}
require __DIR__ . '/../src/bootstrap.php';

$args = array_slice($argv, 1);
$cmd = array_shift($args) ?? 'help';
$opts = [];
foreach ($args as $a) {
    if (preg_match('/^--([\w-]+)(?:=(.*))?$/', $a, $m)) {
        $opts[$m[1]] = $m[2] ?? true;
    }
}
$out = fn(string $s) => fwrite(STDOUT, $s . "\n");
$progress = function (string $msg) {
    if (posix_isatty(STDOUT)) {
        fwrite(STDOUT, "\r\033[K" . $msg);
    }
};

try {
    switch ($cmd) {
        case 'migrate':
            wk_db();
            $out('Schema version ' . wk_setting('schema_version'));
            break;

        case 'prune':
            $orphans = wk_orphan_libraries();
            if (!$orphans) {
                $out('No unconfigured libraries.');
                break;
            }
            foreach ($orphans as $lib) {
                $n = (int) wk_val('SELECT COUNT(*) FROM series WHERE library_id = ?', [$lib['id']]);
                $out(sprintf('%s (%s): %d series', $lib['name'], $lib['path'], $n));
            }
            if (!isset($opts['yes'])) {
                $out('Run again with --yes to delete these libraries and their series.');
                break;
            }
            wk_q('DELETE FROM libraries WHERE id IN (' . wk_in($orphans) . ')', array_column($orphans, 'id'));
            $out('Deleted.');
            break;

        case 'user':
            $sub = $args[0] ?? 'list';
            $name = $args[1] ?? '';
            $find = function () use ($name) {
                return wk_one('SELECT * FROM users WHERE username_key = ?', [mb_strtolower($name)])
                    ?? throw new InvalidArgumentException("No user called '$name'");
            };
            $askPassword = function () use ($opts): string {
                if (isset($opts['password']) && is_string($opts['password'])) {
                    return $opts['password'];
                }
                $tty = posix_isatty(STDIN);
                if ($tty) {
                    system('stty -echo');
                    fwrite(STDOUT, 'Password: ');
                }
                $pw = rtrim((string) fgets(STDIN), "\r\n");
                if ($tty) {
                    system('stty echo');
                    fwrite(STDOUT, "\n");
                }
                return $pw;
            };
            switch ($sub) {
                case 'list':
                    foreach (wk_users() as $u) {
                        $out(sprintf('%-20s %-6s %-11s %-28s %s', $u['username'], $u['role'], $u['status'], $u['email'] ?? '-', $u['max_rating'] ? "up to {$u['max_rating']}" : 'everything'));
                    }
                    break;
                case 'add':
                    $id = wk_user_create($name, $askPassword(), isset($opts['admin']) ? 'admin' : 'user', isset($opts['email']) ? (string) $opts['email'] : null);
                    $out("Created user #$id");
                    break;
                case 'passwd':
                    wk_user_set_password((int) $find()['id'], $askPassword());
                    $out('Password changed; existing sessions were signed out');
                    break;
                case 'role':
                    wk_user_update((int) $find()['id'], ['role' => $args[2] ?? '']);
                    $out('Role updated');
                    break;
                case 'enable':
                case 'disable':
                    wk_user_update((int) $find()['id'], ['status' => $sub === 'enable' ? 'active' : 'disabled']);
                    $out("User {$sub}d");
                    break;
                case 'delete':
                    wk_user_delete((int) $find()['id']);
                    $out('User deleted');
                    break;
                default:
                    throw new InvalidArgumentException("Unknown user command '$sub'");
            }
            break;

        case 'tasks':
            wk_tasks_run_due();
            break;

        case 'worker':
            $out('wankarr worker started; checking for due tasks every 30s');
            while (true) {
                wk_tasks_run_due();
                sleep(30);
            }

        case 'run':
            $task = $args[0] ?? '';
            if (!wk_task_run($task)) {
                $out("$task is already running");
                exit(1);
            }
            $out(wk_val('SELECT message FROM tasks WHERE name = ?', [$task]));
            break;

        case 'scan':
            $r = wk_scan(isset($opts['library']) ? (int) $opts['library'] : null, $progress);
            $out("\n" . wk_task_summary('scan', $r));
            break;

        case 'match':
            $id = (int) ($args[0] ?? 0);
            $out(wk_auto_match($id));
            break;

        case 'status':
            foreach (wk_tasks_state() as $t) {
                $out(sprintf('%-18s %-8s next %s  %s', $t['label'], $t['running'] ? 'running' : 'idle',
                    $t['next_run'] ? date('Y-m-d H:i', (int) $t['next_run']) : 'now', $t['message'] ?? ''));
            }
            foreach (wk_library_stats() as $k => $v) {
                $out(sprintf('%-10s %s', $k, $v));
            }
            break;

        default:
            $out(trim(preg_replace('/^ \* ?/m', '', explode('*/', explode('/**', file_get_contents(__FILE__))[1])[0])));
    }
} catch (Throwable $e) {
    fwrite(STDERR, 'Error: ' . $e->getMessage() . "\n");
    exit(1);
}
